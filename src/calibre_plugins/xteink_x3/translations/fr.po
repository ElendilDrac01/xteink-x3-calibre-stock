msgid "Loading…"
msgstr "Chargement…"

#: action.py:994
msgid ""
"(binary content, showing first bytes as hex)\n"
"\n"
msgstr ""
"(contenu binaire, premiers octets affichés en hexadécimal)\n"
"\n"

