msgstr "%d éléments supprimés du Xteink X3."

#: action.py:3760
#, python-format
msgid ""
"WARNING: the Xteink X3 accepted the deletion request but the following %d "
"item(s) could still be found on the device afterwards — they were likely NOT "
"actually deleted:\n"
"\n"
"%s"
msgstr ""
"ATTENTION : le Xteink X3 a accepté la demande de suppression mais les %d "
"élément(s) suivants ont pu être retrouvés sur l'appareil ensuite — ils n'ont "
"probablement PAS été réellement supprimés :\n"
"\n"
"%s"

