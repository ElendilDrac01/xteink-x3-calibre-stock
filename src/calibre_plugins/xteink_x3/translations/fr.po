#: action.py:857
msgid ""
"Full recursive listing of the Xteink X3's storage. Mainly useful for "
"troubleshooting or looking for undocumented files (e.g. a reading-progress "
"file)."
msgstr ""
"Liste récursive complète du stockage du Xteink X3. Utile principalement pour "
"le dépannage ou pour repérer des fichiers non documentés (par exemple un "
"fichier de progression de lecture)."

#: action.py:878
msgid "Copy to clipboard"
msgstr "Copier dans le presse-papiers"

#: action.py:886 action.py:1303 action.py:1357
msgid "Close"
msgstr "Fermer"

#: action.py:907
msgid "File path to preview (copy it from the tree above, after the \"→\"):"
msgstr ""
"Chemin du fichier à prévisualiser (copiez-le depuis l'arbre ci-dessus, après "
"la « → ») :"

#: action.py:924
msgid "Preview"
msgstr "Aperçu"

#: action.py:940
msgid "File content will appear here."
msgstr "Le contenu du fichier apparaîtra ici."

