msgid "Unable to retrieve the EPUB file.\n\n%s"
msgstr "Impossible de récupérer le fichier EPUB.\n\n%s"

msgid "The selected book has no EPUB format."
msgstr "Le livre sélectionné ne possède pas de format EPUB."

msgid "Book"
msgstr "Livre"

